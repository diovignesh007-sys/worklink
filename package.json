{
  "name": "worklink",
  "version": "0.1.0",
  "private": true,
  "description": "WorkLink — short-term & permanent manual-work marketplace (mobile-first PWA)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.10.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev --workspace @worklink/api",
    "dev:web": "npm run dev --workspace @worklink/web",
    "build": "npm run build --workspace @worklink/types && npm run build --workspace @worklink/api && npm run build --workspace @worklink/web",
    "build:types": "npm run build --workspace @worklink/types",
    "build:api": "npm run build --workspace @worklink/api",
    "build:web": "npm run build --workspace @worklink/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "npm run db:migrate --workspace @worklink/api",
    "db:seed": "npm run db:seed --workspace @worklink/api",
    "test": "npm test --workspaces --if-present",
    "test:api": "npm test --workspace @worklink/api",
    "test:e2e": "npm run test:e2e --workspace @worklink/web",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "npm-run-all2": "^6.2.6",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3"
  }
}
