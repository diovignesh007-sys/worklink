# ── WorkLink environment ──────────────────────────────────────────────
# Copy to .env (root) — docker-compose and both apps read from here.
# NEVER commit real secrets. This file lists every variable the stack reads.

NODE_ENV=development
LOG_LEVEL=debug

# ── Database ───────────────────────────────────────────────────────────
# docker-compose Postgres (with PostGIS). For the zero-Docker local mode the
# API starts an embedded Postgres automatically and ignores DATABASE_URL.
DATABASE_URL=postgres://worklink:worklink@localhost:5432/worklink
# Set to 1 to force embedded-postgres even if DATABASE_URL is reachable
WORKLINK_EMBEDDED_DB=0

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# In-memory fallback used when REDIS_URL is not reachable (dev only)
WORKLINK_INMEMORY_REDIS=1

# ── Auth ───────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me-32-chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32-chars-min
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated allowlist, e.g. http://localhost:3000,https://worklink.app
CORS_ORIGIN=http://localhost:3000

# ── API / Web ──────────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
WEB_PORT=3000

# ── Object storage (S3-compatible) ─────────────────────────────────────
# "local" writes to ./uploads and serves them from the API (dev default).
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=worklink-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MAX_UPLOAD_MB=5

# ── Maps / geocoding (MapProvider abstraction) ─────────────────────────
# "google" | "osm" | "none" — "none" returns deterministic offline results.
MAP_PROVIDER=none
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── OTP channels ───────────────────────────────────────────────────────
OTP_CHANNEL=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# ── Email ──────────────────────────────────────────────────────────────
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=WorkLink <no-reply@worklink.app>

# ── Push (Web Push VAPID keys) ─────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@worklink.app

# ── Payments (Phase 7, feature-flagged) ────────────────────────────────
PAYMENTS_ENABLED=0
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Sentry (optional) ──────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
